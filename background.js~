
chrome.runtime.onMessage.addListener((message) => { 
  if (message.action === 'start') { 
    chrome.alarms.create('checkPage', { periodInMinutes: 1 }); 
  } else if (message.action === 'stop') { 
    chrome.alarms.clear('checkPage'); 
  } 
});

chrome.alarms.onAlarm.addListener((alarm) => { 
  if (alarm.name === 'checkPage') { 
    checkPage(); 
  } 
});

async function checkPage() { 
  const { targetUrl, discordWebhook } = await chrome.storage.sync.get(['targetUrl', 'discordWebhook']); 
  const { cachedContent } = await chrome.storage.local.get('cachedContent');

  if (!targetUrl) return;

  try {
    const response = await fetch(targetUrl);
    const currentContent = await response.text();

    // If we have previous content cached and it changed
    if (cachedContent && cachedContent !== currentContent) {
      if (discordWebhook) {
        // Send alert exclusively to Discord webhook
        await sendDiscordAlert(discordWebhook, targetUrl);
      }
    }

    // Update the cache with the newest version of the page
    await chrome.storage.local.set({ cachedContent: currentContent });
  } catch (error) {
    console.error('Error checking target page:', error);
  }
}

async function sendDiscordAlert(webhookUrl, url) {
  try {
    await fetch(webhookUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        content: `🕷️ **Ossa Alert:** Content has changed on your monitored target URL: ${url}`
      })
    });
  } catch (error) {
    console.error('Failed to send Discord webhook:', error);
  }
}
